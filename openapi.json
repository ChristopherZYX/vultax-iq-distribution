{
  "openapi": "3.0.3",
  "info": {
    "title": "Vi IQ by Vultax — Crypto Market Quality API",
    "version": "0.1.0",
    "description": "Read-only Vi IQ crypto observations with six factors, source timestamps, coverage and producer fallback notes. A consumer key or marketplace subscription is required for IQ data. Source-reported indicators are not forecasts; metadata reports actual observed history and model-version availability.",
    "contact": {
      "name": "Vultax",
      "url": "https://vultax.com",
      "email": "support@vultax.com"
    }
  },
  "servers": [
    {
      "url": "https://api.vultax.com/marketplace",
      "description": "Vi IQ gateway; authenticated data access, public coverage metadata."
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/iq": {
      "get": {
        "operationId": "getIqBatch",
        "summary": "Retrieve bounded Vi IQ observations",
        "parameters": [
          {
            "name": "pairs",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "BTCUSDT"
            },
            "description": "Comma-separated pairs from metadata. BASIC:1, PRO:3, ULTRA:25 maximum."
          }
        ],
        "responses": {
          "200": {
            "description": "Observed IQ records. Billing counts non-null score records returned. History dates use collected_at; truncated responses contain the newest records in the window.",
            "headers": {
              "X-RapidAPI-Billing": {
                "schema": {
                  "type": "string"
                },
                "description": "Provider response: Records=N. Configure a hard custom Records quota in RapidAPI."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "records_billed"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/IqObservation"
                      }
                    },
                    "records_billed": {
                      "type": "integer"
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "unavailable_pairs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "source_warning": {
                      "type": "string",
                      "nullable": true
                    },
                    "change": {
                      "type": "object",
                      "properties": {
                        "score_delta": {
                          "type": "number",
                          "nullable": true
                        },
                        "reason": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error response; unavailable scores are never fabricated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
