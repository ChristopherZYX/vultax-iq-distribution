  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "IqObservation": {
        "type": "object",
        "required": [
          "pair",
          "score",
          "model_id",
          "model_version",
          "collected_at",
          "source_as_of",
          "factors",
          "freshness",
          "observation_id"
        ],
        "properties": {
          "pair": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "nullable": true,
            "minimum": 1,
            "maximum": 100
          },
          "model_id": {
            "type": "string",
            "enum": [
              "vultax.crypto.vi-iq"
            ]
          },
          "model_version": {
            "type": "string",
            "nullable": true
          },
          "model_identity_status": {
            "type": "string",
            "enum": [
              "configured_producer_version",
              "unversioned_upstream"
            ]
          },
          "schema_version": {
            "type": "string"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "source_as_of": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "upstream_timestamp": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp reported by the producer. It is not represented as a verified computation or market quote time."
          },
          "freshness": {
            "type": "string",
            "enum": [
              "fresh",
              "stale",
              "unknown"
            ]
          },
          "factors": {
            "type": "object",
            "required": [
              "market_quality",
              "liquidity_health",
              "arbitrage_potential",
              "order_flow",
              "volatility",
              "news_sentiment"
            ],
            "properties": {
              "market_quality": {
                "type": "object",
                "required": [
                  "score",
                  "weight",
                  "source_as_of",
                  "freshness"
                ],
                "properties": {
                  "score": {
                    "type": "number",
                    "nullable": true,
                    "minimum": 0,
                    "maximum": 100
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "coverage": {
                    "type": "number",
                    "nullable": true
                  },
                  "confidence": {
                    "type": "number",
                    "nullable": true
                  },
                  "source_as_of": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "source_as_of_raw": {
                    "type": "string",
                    "nullable": true,
                    "description": "Original producer timestamp. Without an explicit timezone, normalized time stays null and freshness is unknown."
                  },
                  "label": {
                    "type": "string",
                    "nullable": true
                  },
                  "details": {
                    "type": "string",
                    "nullable": true
                  },
                  "notes": {
                    "type": "array",
                    "nullable": true,
                    "items": {
                      "type": "string"
                    },
                    "description": "Producer notes, including fallback and stale-input warnings."
                  },
                  "freshness": {
                    "type": "string",
                    "enum": [
                      "fresh",
                      "stale",
                      "unknown"
                    ]
                  }
                }
              },
              "liquidity_health": {
                "type": "object",
                "required": [
                  "score",
                  "weight",
                  "source_as_of",
                  "freshness"
                ],
                "properties": {
                  "score": {
                    "type": "number",
                    "nullable": true,
                    "minimum": 0,
                    "maximum": 100
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "coverage": {
                    "type": "number",
                    "nullable": true
                  },
                  "confidence": {
                    "type": "number",
                    "nullable": true
                  },
                  "source_as_of": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "source_as_of_raw": {
                    "type": "string",
                    "nullable": true,
                    "description": "Original producer timestamp. Without an explicit timezone, normalized time stays null and freshness is unknown."
                  },
                  "label": {
                    "type": "string",
