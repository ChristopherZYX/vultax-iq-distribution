# Dedicated server-side IQ reader credential; never use a browser cookie here.
VULTAX_UPSTREAM_URL=https://api.vultax.com
VULTAX_UPSTREAM_KEY=
# Set only to a verified identifier supplied by the score producer.
VI_IQ_MODEL_VERSION=
VI_IQ_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT
VI_IQ_CACHE_SECONDS=60
VI_IQ_STALE_SECONDS=300
VI_IQ_RETENTION_DAYS=30
PORT=3189
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3189
STATE_PATH=./state/iq.sqlite
# SHA256 hashes of consumer keys, not the keys themselves. Example structure:
# [{"id":"customer-1","sha256":"64-hex-digits","plan":"PRO"}]
API_CLIENTS_JSON=[]
# Unique value provided by the RapidAPI listing's Security tab.
RAPIDAPI_PROXY_SECRET=
